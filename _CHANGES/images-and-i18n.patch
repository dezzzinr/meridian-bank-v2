+/**
+ * Optional overrides filled in by `npm run i18n:fill` (scripts/i18n-fill.ts).
+ * Shape: { "English source text": { "de": "...", "fr": "...", ... } }
+ * Kept separate so hand-written copy in STRINGS above is never overwritten.
+ */
+import FILLED from "@/lib/i18n/filled.json";
+
+const filled = FILLED as Record<string, Partial<Record<string, string>>>;
+
+/** Every English string the runtime can translate, from STRINGS and FILLED. */
+export function translatedIndex(locale: string): Map<string, string> {
+  const index = new Map<string, string>();
+  for (const entry of Object.values(STRINGS)) {
+    const target = (entry as Record<string, string | undefined>)[locale];
+    if (target) index.set(normaliseKey(entry.en), target);
+  }
+  for (const [source, byLocale] of Object.entries(filled)) {
+    const target = byLocale?.[locale];
+    if (target) index.set(normaliseKey(source), target);
+  }
+  return index;
+}
+
+export function normaliseKey(value: string) {
+  return value.replace(/\s+/g, " ").trim();
+}
